{
  "manifest_version": 3,
  "name": "Cloud Computer AI.com YouTube Viewer Bridge",
  "version": "0.1.0",
  "description": "Forward approved YouTube live-chat view commands to the viewer's selected Cloud Computer AI.com tab.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.replit.app/*",
    "https://*.replit.dev/*",
    "https://*.repl.co/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Cloud Computer AI.com YouTube Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["commands.js", "youtube-chat-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.replit.app/*",
        "https://*.replit.dev/*",
        "https://*.repl.co/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["gev-content.js"],
      "run_at": "document_idle"
    }
  ]
}