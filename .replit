modules = ["web", "bash", "nodejs-24", "python-base-3.13"]

[nix]
channel = "stable-25_05"
packages = ["ffmpeg"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "HOST=0.0.0.0 PORT=5000 bash scripts/dev-replit.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 5100
externalPort = 3002

[[ports]]
localPort = 24678
externalPort = 3000

[deployment]
deploymentTarget = "vm"
run = ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "5000"]
build = ["npm", "run", "build"]

[userenv]

[userenv.shared]
GEV_AUTO_GO_LIVE = "true"
YOUTUBE_INGEST_URL = "rtmp://a.rtmp.youtube.com/live2"
YOUTUBE_WATCH_URL = "https://www.youtube.com/watch?v=0e5MwKCdZDY"


